{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python bin/compilar_css.py && python manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": ["python manage.py migrate --noinput"],
    "startCommand": "gunicorn vivasoccer.wsgi --workers 2 --access-logfile -",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
